# Supabase project settings (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only key. Keep out of NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY

# Deriv OAuth app settings from developers.deriv.com
DERIV_CLIENT_ID=REPLACE_ME
DERIV_REDIRECT_URI=http://localhost:3000/api/deriv/callback
# 32-byte key encoded as 64 hex characters. Generate with: openssl rand -hex 32
DERIV_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS
APP_BASE_URL=http://localhost:3000

# Worker
DATABASE_URL=postgresql://... # Supabase direct/session pooler URL; worker only
WORKER_POLL_INTERVAL_MS=5000
LIVE_TRADING_ENABLED=false
