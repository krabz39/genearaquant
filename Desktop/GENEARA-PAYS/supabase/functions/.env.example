# LOCAL DEVELOPMENT ONLY. Copy to supabase/functions/.env and never commit it.
# Use the Safaricom Daraja sandbox first; use production credentials only after
# the Daraja app, shortcode, callback domain, and go-live approval are confirmed.

DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=replace_with_sandbox_consumer_key
DARAJA_CONSUMER_SECRET=replace_with_sandbox_consumer_secret
DARAJA_SHORTCODE=replace_with_shortcode
DARAJA_PASSKEY=replace_with_stk_passkey
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_CALLBACK_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/mpesa-callback

# Set this to the exact customer site origin when known.
APP_ORIGIN=https://your-customer-domain.example
